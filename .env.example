# ============================================================
# Song ID — Environment Variables
# Copy this to .env for local dev, set these in Railway for production
# ============================================================

# PostgreSQL — provided automatically by Railway Postgres plugin
DATABASE_URL=postgresql+psycopg2://user:password@host:port/dbname

# Redis — provided automatically by Railway Redis plugin
REDIS_URL=redis://default:password@host:port

# Cloudflare R2 — get from Cloudflare dashboard
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
